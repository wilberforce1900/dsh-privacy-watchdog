{
  "allowed_hosts": [
    "api.deepseek.com"
  ],
  "protected_paths": [
    ".env",
    ".ssh/",
    "id_rsa",
    ".gitconfig",
    ".netrc",
    "credentials"
  ],
  "trusted_read_hosts": [
    "pypi.org",
    "files.pythonhosted.org",
    "registry.npmjs.org",
    "github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "docs.python.org"
  ],
  "scope_exempt_tools": ["model_message"],
  "severity_threshold": "high",
  "max_payload_preview": 400,
  "max_pauses_per_turn": 3
}
